FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY config.py .
COPY audio_classifier.py .
COPY bird_info.py .
COPY services/__init__.py services/__init__.py
COPY services/audio_service.py services/audio_service.py

EXPOSE 8002

CMD ["python", "-m", "uvicorn", "services.audio_service:app", "--host", "0.0.0.0", "--port", "8002"]
